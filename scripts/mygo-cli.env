# Pinned MyGo CLI used by the trusted signing stage.
#
# The signing job takes the linux/amd64 binary from the verified build job,
# checks it against this digest, and runs it with the updater key. The
# binary is never installed or replaced while the signing key is present.
MYGO_CLI_VERSION="0.9.2"
MYGO_CLI_LINUX_X64_SHA256="5076fb6b8922ba31ff9965206cc39ccc550e85dd371afaacd5980f2080e4ab92"
